# ── Secrets & credentials ───────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
.cloudflared/

# ── Data volumes (databases, vector store) ──────────────────────
data/chroma/*
!data/chroma/.gitkeep
# n8n's volume, left behind when SP50 retired the integration. Nothing writes it any more and
# it is safe to delete by hand; it stays ignored rather than merely deleted from this file,
# because dropping the rule while the directory is still on disk turns a live volume into
# untracked files that `git add -A` would stage. It did, on the branch that retired n8n.
data/n8n/
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
# SQLite's WAL sidecars. `*.db` does not match `foo.db-wal`, so a running API server leaves
# these showing as untracked next to databases that are themselves ignored - and a `git add -A`
# then stages live client data. Found exactly that way.
*.db-wal
*.db-shm
*.sqlite3

# ── Project data (client-specific) ──────────────────────────────
models/
projects/*
!projects/example/
!projects/example/**

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
venv/
.venv/

# ── Node ────────────────────────────────────────────────────────
# Unanchored, so it catches the stray root-level node_modules/ that a
# vite invocation from the wrong directory leaves behind, not just ui/.
node_modules/
ui/dist/

# ── Runtime / tooling ───────────────────────────────────────────
.pids/
.worktrees/
.superpowers/
.playwright-mcp/
.DS_Store
*.log

# ── Scratch artefacts at repo root ──────────────────────────────
# Leading slash confines these to the root so genuine assets under
# ui/public/ stay tracked.
/*.png
/*.jpg
/*.docx
/*.pdf

# ── Local image backups ─────────────────────────────────────────
ui/public/agents/oldagents/
# Playwright accessibility dumps written to the repo root when a bare
# filename is passed to browser_snapshot - they belong in .playwright-mcp/
/*-team.yml
/page-*.yml
