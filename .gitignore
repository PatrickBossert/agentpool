# ── Secrets & credentials ───────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
.cloudflared/

# ── Data volumes (databases, vector store) ──────────────────────
data/chroma/*
!data/chroma/.gitkeep
data/n8n/*
!data/n8n/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# ── Project data (client-specific) ──────────────────────────────
models/
projects/*
!projects/example/
!projects/example/**

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
venv/
.venv/

# ── Node ────────────────────────────────────────────────────────
# Unanchored, so it catches the stray root-level node_modules/ that a
# vite invocation from the wrong directory leaves behind, not just ui/.
node_modules/
ui/dist/

# ── Runtime / tooling ───────────────────────────────────────────
.pids/
.worktrees/
.superpowers/
.chainlit/
.playwright-mcp/
.DS_Store
*.log

# ── Scratch artefacts at repo root ──────────────────────────────
# Leading slash confines these to the root so genuine assets under
# ui/public/ stay tracked.
/*.png
/*.jpg
/*.docx
/*.pdf

# ── Local image backups ─────────────────────────────────────────
ui/public/agents/oldagents/
# Playwright accessibility dumps written to the repo root when a bare
# filename is passed to browser_snapshot - they belong in .playwright-mcp/
/*-team.yml
/page-*.yml
