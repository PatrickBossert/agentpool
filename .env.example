# .env.example — copy to .env and fill in real values (never commit .env)

# ── Anthropic / LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_PROXY_URL=http://localhost:4000
# Per-agent local model routing (sensitive projects) is configured per project, in the
# project's own settings - local_fast_model, local_fast_url, local_deep_model, local_deep_url -
# not here. See api/models.py ProjectSettings.

# ── Admin credentials (required — app will not start without these) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Home organisation ────────────────────────────────────────────
# The consultancy. One organisation, not one per client: every engagement belongs to it, and
# an org_admin appointed in it reaches every engagement. Seeded automatically on first system
# connection, and the organisation new projects are registered to when the creator's token
# carries no org_id of its own (which is every sysadmin). Renaming it afterwards through
# PATCH /auth/orgs/{id} sticks - the seed keys on the slug.
HOME_ORG_SLUG=future-edge
HOME_ORG_NAME=Future Edge Consulting

# ── ChromaDB ─────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8002
# For ChromaDB Cloud — set CHROMA_API_KEY to use CloudClient instead of HttpClient
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# ── Storage ──────────────────────────────────────────────────────
DATABASE_DIR=./data
# Content-addressed caches (e.g. synthesised speech) live under DATA_DIR/<cache-name>
DATA_DIR=data
PROJECTS_DIR=./projects

# ── URLs ─────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000
# Production: set to your public domain, e.g. https://taskreimagination.ai
# PUBLIC_URL=https://taskreimagination.ai

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=TaskReimagination <noreply@taskreimagination.ai>
# Used entire for platform mail (the welcome email). For a project's mail only the DOMAIN
# is taken from here: those messages are sent from a role address minted from the
# correspondent's agent id - stakeholder-manager@ and pam@ - so that a reply reaches
# whoever holds the role rather than a named person. One mailbox per role, and moving
# domain here moves them all. See api/services/outbound_mail.py.
#
# Where a project with dev_mode on sends its mail instead of to its real stakeholders.
# dev_mode defaults to on for every new project, so set this to an address you own
# before enabling Resend - held mail is delivered, not discarded.
DEV_MODE_ADDRESS=Patrick@FutureEdge.consulting

# ── Voice / Transcription ─────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── Web search ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Cloudflare Tunnel (production only) ──────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
